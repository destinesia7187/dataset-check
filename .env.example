# Copy to .env for reference. Uvicorn does not load it automatically: export the
# variables in your shell, or pass them in compose.yaml before starting.
# DATA_DIR must be persistent across restarts and outside frontend/dist.
DATA_DIR=./data
# FRONTEND_DIST defaults to <repository>/frontend/dist.
# FRONTEND_DIST=./frontend/dist
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# Optional overrides; defaults shown. Capabilities is the source for clients.
MAX_FILE_SIZE_BYTES=20971520
MAX_REQUEST_BODY_BYTES=21037056
MAX_ROWS=100000
MAX_COLUMNS=100
MAX_CELLS=2000000
MAX_CELL_LENGTH_CHARS=65536
MAX_HEADER_LENGTH_CHARS=128
MAX_FILENAME_LENGTH_CHARS=255
MAX_DATASETS=3
MAX_RUNS_PER_DATASET=3
MAX_ISSUES_PER_RUN=100000
IMPORT_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=120
UPLOAD_TIMEOUT_SECONDS=60
MAX_STORAGE_BYTES=1073741824
STORAGE_RESERVE_BYTES=8388608
METADATA_COMPLETION_RESERVATION_BYTES=65536
MAX_TERMINAL_ERROR_BYTES=16384
CLEANUP_GRACE_SECONDS=5
DATASET_IDLE_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
IDEMPOTENCY_RETENTION_AFTER_COMPLETION_SECONDS=86400
